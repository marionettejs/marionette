    "recorded_public_reading_findings": [
      {
        "id": "section-access",
        "priority": 1,
        "finding": "Recorded readers frequently failed focused section retrieval and then fetched broad references.",
        "measured": {
          "attempts_with_helper_error": 6,
          "helper_error_responses": 8,
          "helper_errors_with_zero_shell_exit": 7,
          "attempts": 7,
          "largest_observed_complete_reference_chars": 30000
        },
        "ordinary_reader_validation": "Public helper modes are mutually exclusive. Section lookup requires an ID from the generated section index, not a page-heading string or URL anchor. Six matching public sections were validated independently from frozen byte offsets; their complete contracts are unchanged.",
        "general_action": "Make the entry instructions demonstrate search then copy the returned section ID, with a clear distinction between page source paths, section IDs and website anchors. Warn that a shell pipeline can conceal helper failure. Keep references, ranking and runtime unchanged.",
        "causal_limit": "This directly accounts for eight error responses and observed fallback reading; it does not quantify saved dollars or prove all broader reading unnecessary."
