{
  "name": "@mnjs/formkit",
  "description": "Native Marionette views backed by FormKit nodes",
  "version": "5.0.0-rc.2",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "readme.md",
    "license.txt",
    "compatibility.md",
    "OWNERSHIP.md",
    "rows.md",
    "schema-views.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "build": "node ../../build/clean.js && rollup -c rollup.config.mjs && node ../../build/declarations.mjs formkit",
    "prepack": "npm run build"
  },
  "keywords": [
    "marionette",
    "forms",
    "formkit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/formkit"
  },
  "dependencies": {
    "@formkit/core": "2.1.2",
    "@formkit/validation": "2.1.2",
    "@formkit/rules": "2.1.2",
    "@formkit/i18n": "2.1.2",
    "@formkit/inputs": "2.1.2",
    "@formkit/themes": "2.1.2",
    "@formkit/utils": "2.1.2",
    "@formkit/observer": "2.1.2"
  },
  "peerDependencies": {
    "marionette": "^5.0.0-rc.2"
  }
}
