{
  "name": "mnjs-test-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --project dom",
    "test:browser": "vitest run --project browser",
    "test:playwright": "playwright test",
    "test:cypress": "cypress run --component --browser electron",
    "dev": "vite --host 127.0.0.1 --port 4187 --strictPort",
    "test:consumer": "node --import ./dom.js consumer.mjs && node --import ./dom.js consumer.cjs && tsc -p tsconfig.json && tsc -p cypress/tsconfig.json"
  },
  "dependencies": {
    "@mnjs/test": "file:..",
    "marionette": "5.0.0"
  },
  "devDependencies": {
    "@cypress/mount-utils": "5.0.0",
    "@cypress/vite-dev-server": "8.0.0",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.8",
    "@vitest/browser-playwright": "5.0.5",
    "cypress": "16.2.0",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
