{
  "name": "@mnjs/test",
  "version": "0.1.0",
  "description": "Runner-independent mounting and owned-resource cleanup for Marionette v5 tests",
  "homepage": "https://github.com/marionettejs/marionette/tree/master/packages/test#readme",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./cypress": {
      "import": {
        "types": "./dist/types/esm/cypress.d.ts",
        "default": "./dist/cypress.js"
      },
      "require": {
        "types": "./dist/types/cjs/cypress.d.ts",
        "default": "./dist/cypress.cjs"
      }
    },
    "./playwright": {
      "import": {
        "types": "./dist/types/esm/playwright.d.ts",
        "default": "./dist/playwright.js"
      },
      "require": {
        "types": "./dist/types/cjs/playwright.d.ts",
        "default": "./dist/playwright.cjs"
      }
    },
    "./testing-library": {
      "import": {
        "types": "./dist/types/esm/testing-library.d.ts",
        "default": "./dist/testing-library.js"
      },
      "require": {
        "types": "./dist/types/cjs/testing-library.d.ts",
        "default": "./dist/testing-library.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/types/esm/vitest.d.ts",
        "default": "./dist/vitest.js"
      }
    }
  },
  "files": [
    "dist/",
    "readme.md",
    "guide.md",
    "license.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "peerDependencies": {
    "marionette": "^5.0.0",
    "@cypress/mount-utils": "^4.0.0 || ^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "cypress": ">=14",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "node ../../build/clean.js && rollup -c rollup.config.mjs && node ../../build/declarations.mjs test",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marionettejs/marionette/issues"
  },
  "keywords": [
    "marionette",
    "testing",
    "lifecycle"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/test"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    },
    "@cypress/mount-utils": {
      "optional": true
    },
    "cypress": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
