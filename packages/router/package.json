{
  "name": "@mnjs/router",
  "description": "Named routing and child Application switching for Marionette v5",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "readme.md",
    "DESIGN.md",
    "PROVENANCE.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "node ../../build/clean.js && rollup -c rollup.config.mjs && node ../../build/declarations.mjs router",
    "test": "npm --prefix ../.. test -- test/unit/router",
    "check:types": "tsc -p ../../tsconfig.json"
  },
  "keywords": [
    "marionette",
    "router",
    "routing",
    "navigation-api",
    "urlpattern"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/router"
  },
  "private": true,
  "peerDependencies": {
    "marionette": "5.0.0"
  }
}
