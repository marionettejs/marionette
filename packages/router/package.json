{
  "name": "@mnjs/router",
  "version": "0.0.0-prototype.0",
  "private": true,
  "description": "Experimental framework-neutral URL routing and navigation authority",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "readme.md",
    "license.txt",
    "design.md",
    "verification.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config ../../test/router/vitest.config.mjs",
    "test:types": "node ../../test/router/consumer.mjs",
    "test:browser": "node ../../test/router/browser.mjs",
    "prepack": "npm run build"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/router"
  }
}
