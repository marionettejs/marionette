{
  "name": "@mnjs/radio",
  "description": "Channels and request/reply messaging for Marionette",
  "version": "5.0.0-beta.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "readme.md",
    "license.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node ../../build/clean.js && rollup -c rollup.config.mjs && node ../../build/declarations.mjs radio",
    "prepack": "npm run build"
  },
  "keywords": [
    "marionette",
    "events",
    "radio",
    "messaging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/radio"
  },
  "dependencies": {
    "@mnjs/utils": "5.0.0-beta.1"
  }
}
