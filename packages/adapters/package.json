{
  "name": "@marionette/adapters",
  "description": "Optional data, DOM and rendering integrations for Marionette",
  "version": "5.0.0-alpha.2",
  "type": "module",
  "exports": {
    "./backbone": {
      "import": {
        "types": "./dist/types/esm/data/backbone.d.ts",
        "default": "./dist/backbone.js"
      },
      "require": {
        "types": "./dist/types/cjs/data/backbone.d.ts",
        "default": "./dist/backbone.cjs"
      },
      "default": "./dist/backbone.js"
    },
    "./dom/jquery": {
      "import": {
        "types": "./dist/types/esm/dom/jquery.d.ts",
        "default": "./dist/dom/jquery.js"
      },
      "require": {
        "types": "./dist/types/cjs/dom/jquery.d.ts",
        "default": "./dist/dom/jquery.cjs"
      },
      "default": "./dist/dom/jquery.js"
    },
    "./redux": {
      "import": {
        "types": "./dist/types/esm/data/redux.d.ts",
        "default": "./dist/redux.js"
      },
      "require": {
        "types": "./dist/types/cjs/data/redux.d.ts",
        "default": "./dist/redux.cjs"
      },
      "default": "./dist/redux.js"
    },
    "./zustand": {
      "import": {
        "types": "./dist/types/esm/data/zustand.d.ts",
        "default": "./dist/zustand.js"
      },
      "require": {
        "types": "./dist/types/cjs/data/zustand.d.ts",
        "default": "./dist/zustand.cjs"
      },
      "default": "./dist/zustand.js"
    },
    "./xstate-store": {
      "import": {
        "types": "./dist/types/esm/data/xstate-store.d.ts",
        "default": "./dist/xstate-store.js"
      },
      "require": {
        "types": "./dist/types/cjs/data/xstate-store.d.ts",
        "default": "./dist/xstate-store.cjs"
      },
      "default": "./dist/xstate-store.js"
    },
    "./xstate": {
      "import": {
        "types": "./dist/types/esm/data/xstate.d.ts",
        "default": "./dist/xstate.js"
      },
      "require": {
        "types": "./dist/types/cjs/data/xstate.d.ts",
        "default": "./dist/xstate.cjs"
      },
      "default": "./dist/xstate.js"
    },
    "./package.json": "./package.json",
    "./render/morphdom": {
      "import": {
        "types": "./dist/types/esm/render/morphdom.d.ts",
        "default": "./dist/render/morphdom.js"
      },
      "require": {
        "types": "./dist/types/cjs/render/morphdom.d.ts",
        "default": "./dist/render/morphdom.cjs"
      },
      "default": "./dist/render/morphdom.js"
    },
    "./render/lit-html": {
      "import": {
        "types": "./dist/types/esm/render/lit-html.d.ts",
        "default": "./dist/render/lit-html.js"
      },
      "require": {
        "types": "./dist/types/cjs/render/lit-html.d.ts",
        "default": "./dist/render/lit-html.cjs"
      },
      "default": "./dist/render/lit-html.js"
    }
  },
  "files": [
    "dist/",
    "readme.md",
    "license.txt"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@types/backbone": "^1.4.23",
    "@types/jquery": "^4.0.1",
    "backbone": "^1.4.0",
    "jquery": "^4.0.0",
    "marionette": "5.0.0-alpha.2",
    "morphdom": "^2.7.8",
    "lit-html": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@types/backbone": {
      "optional": true
    },
    "@types/jquery": {
      "optional": true
    },
    "backbone": {
      "optional": true
    },
    "jquery": {
      "optional": true
    },
    "morphdom": {
      "optional": true
    },
    "lit-html": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node ../../build/clean.js && rollup -c rollup.config.mjs && node ../../build/declarations.mjs adapters",
    "prepack": "npm run build"
  },
  "keywords": [
    "backbone",
    "jquery",
    "marionette",
    "adapter",
    "redux",
    "xstate",
    "zustand"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marionettejs/marionette.git",
    "directory": "packages/adapters"
  }
}
