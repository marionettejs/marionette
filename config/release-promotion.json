{
  "schemaVersion": 2,
  "publication": {
    "stable": false,
    "prerelease": null
  },
  "repository": "marionettejs/marionette",
  "defaultBranch": "master",
  "workflow": "release.yml",
  "environment": "stable-release",
  "artifactRetentionDays": 90,
  "npm": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "stableTag": "latest",
    "prereleaseTag": "next",
    "trustedPublisher": {
      "provider": "github-actions",
      "workflow": "release.yml",
      "environment": "stable-release"
    }
  }
}
