{
  "name": "marionette-beta-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test workspace.test.mjs",
    "build": "vite build",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:browser": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "typescript": "6.0.3",
    "eslint": "10.13.0",
    "@typescript-eslint/parser": "8.72.0",
    "@playwright/test": "1.64.1"
  },
  "engines": {
    "node": ">=24"
  }
}
