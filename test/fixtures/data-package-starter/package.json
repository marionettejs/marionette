{
  "name": "marionette-beta-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test workspace.test.mjs",
    "build": "vite build",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:browser": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "jsdom": "30.1.1",
    "vite": "8.3.1",
    "typescript": "7.0.2",
    "eslint": "10.11.0",
    "@typescript-eslint/parser": "8.70.1",
    "@playwright/test": "1.63.0"
  },
  "engines": {
    "node": ">=24"
  }
}
