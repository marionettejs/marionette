{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/types/esm",
    "noEmitOnError": true,
    "paths": {
      "@mnjs/utils": [
        "./packages/utils/dist/types/esm/index.d.ts"
      ],
      "@mnjs/radio": [
        "./packages/radio/dist/types/esm/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
